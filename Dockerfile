# Stage 1: Build the Vite application
FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .

# Declare build arguments for Vite environment variables
ARG VITE_PATROLX_API_URL
ARG VITE_PATROLX_API_KEY
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_INCIDENT_POLL_MS
ARG VITE_DEFAULT_LAT
ARG VITE_DEFAULT_LNG
ARG VITE_DEFAULT_ZOOM
ARG VITE_DEFAULT_COUNTY

# Map build args to environment variables so Vite can read them during build
ENV VITE_PATROLX_API_URL=$VITE_PATROLX_API_URL
ENV VITE_PATROLX_API_KEY=$VITE_PATROLX_API_KEY
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
ENV VITE_INCIDENT_POLL_MS=$VITE_INCIDENT_POLL_MS
ENV VITE_DEFAULT_LAT=$VITE_DEFAULT_LAT
ENV VITE_DEFAULT_LNG=$VITE_DEFAULT_LNG
ENV VITE_DEFAULT_ZOOM=$VITE_DEFAULT_ZOOM
ENV VITE_DEFAULT_COUNTY=$VITE_DEFAULT_COUNTY

RUN npm run build

# Stage 2: Serve with Nginx
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]